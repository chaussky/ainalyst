# AInalyst environment variable template
# Copy it to .env and fill in your own values:
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Confluence, option A: Confluence Cloud (Atlassian)
# ---------------------------------------------------------------------------

CONFLUENCE_URL=https://your-domain.atlassian.net
CONFLUENCE_USERNAME=your@email.com
CONFLUENCE_API_TOKEN=your-api-token         # https://id.atlassian.com/manage-profile/security/api-tokens
CONFLUENCE_CLOUD=true
CONFLUENCE_SPACE_KEY=BA                     # default space key, for example BA or PROJ

# ---------------------------------------------------------------------------
# Confluence, option B: Confluence Server / Data Center
# ---------------------------------------------------------------------------
# Uncomment and fill these in instead of option A.
# PAT is supported starting from Confluence 7.9+.

# CONFLUENCE_URL=https://wiki.your-company.com
# CONFLUENCE_API_TOKEN=your-personal-access-token
# CONFLUENCE_CLOUD=false
# CONFLUENCE_SPACE_KEY=BA
