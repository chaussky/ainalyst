.ainalyst_phase

# Python
__pycache__/
*.pyc
*.pyo

# Environment variables (Confluence keys, etc.)
.env
.env.local
#.env.*

# Input materials: transcripts, regulations, confidential client documents
inputs/*
!inputs/README.md

# Project artifacts: data for specific BA projects, not part of the tool
governance_plans/data/*
governance_plans/reports/*
# Previous generations of those same artifacts, kept by write_json_artifact so a
# damaged file can be restored. Same content, same reason to stay out of the repo.
governance_plans/.history/
# Keep the folders themselves in the repository
!governance_plans/data/.gitkeep
!governance_plans/reports/.gitkeep

# Generated automatically by: python phase.py <phase>
.mcp.json

# Editor and OS system files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Internal process artifacts (brainstorming specs, implementation plans) and
# marketing copy (content plans, draft posts).
# They contain internal strategy, not part of the product, and are not published on GitHub.
docs/superpowers/
.superpowers/
Dev/
marketing/

# The second, LOCAL repository that snapshots the whole tree, including everything the
# rule above keeps out of this one. It lives here rather than only in .git/info/exclude
# because that file is per-clone and is never published: a fresh clone would leave this
# directory untracked-but-not-ignored, and a single `git add -A` would commit the entire
# internal history into the public repository.
.git-internal/

# Local machine-specific / test scratch files (not for the public repo).
/test_input.docx
.claude/statusline-command.sh

# Per-machine Claude Code settings, written by the tool itself. Ignored for the same
# reason: it is machine-specific for the author and for every user who clones this.
.claude/settings.local.json
